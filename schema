CREATE FUNCTION public.check_market_data_quality() RETURNS TABLE(check_name text, issue_count bigint, severity text, description text)
    LANGUAGE plpgsql
    AS $$
BEGIN
    -- Check 1: Properties without location
    RETURN QUERY
    SELECT 
        'Missing Location Data'::TEXT,
        COUNT(*)::BIGINT,
        'HIGH'::TEXT,
        'Properties missing district or tehsil information'::TEXT
    FROM properties
    WHERE status = 'APPROVED' AND (district IS NULL OR tehsil IS NULL);
    
    -- Check 2: Transfers with zero or negative amounts
    RETURN QUERY
    SELECT 
        'Invalid Transfer Amounts'::TEXT,
        COUNT(*)::BIGINT,
        'HIGH'::TEXT,
        'Transfers with zero or negative amounts'::TEXT
    FROM ownership_history
    WHERE transfer_amount <= 0;
    
    -- Check 3: Properties with extremely high transfer amounts (outliers)
    RETURN QUERY
    SELECT 
        'Potential Outliers'::TEXT,
        COUNT(*)::BIGINT,
        'MEDIUM'::TEXT,
        'Transfers exceeding 3x the average (potential data entry errors)'::TEXT
    FROM ownership_history
    WHERE transfer_amount > (SELECT AVG(transfer_amount) * 3 FROM ownership_history);
    
    -- Check 4: Future-dated transfers
    RETURN QUERY
    SELECT 
        'Future Dated Transfers'::TEXT,
        COUNT(*)::BIGINT,
        'HIGH'::TEXT,
        'Transfers with dates in the future'::TEXT
    FROM ownership_history
    WHERE transfer_date > NOW();
    
    -- Check 5: Orphaned ownership records
    RETURN QUERY
    SELECT 
        'Orphaned Records'::TEXT,
        COUNT(*)::BIGINT,
        'LOW'::TEXT,
        'Ownership history records with no matching property'::TEXT
    FROM ownership_history oh
    LEFT JOIN properties p ON oh.property_id = p.property_id
    WHERE p.property_id IS NULL;
    
END;
$$;


