CREATE FUNCTION public.get_user_permissions(p_user_id character varying) RETURNS jsonb
    LANGUAGE plpgsql
    AS $$
DECLARE
    user_role VARCHAR;
    permissions JSONB;
BEGIN
    -- Get user role
    SELECT role INTO user_role FROM users WHERE user_id = p_user_id;
    
    IF user_role IS NULL THEN
        RETURN '{}'::jsonb;
    END IF;
    
    -- Get role permissions
    SELECT rp.permissions INTO permissions 
    FROM role_permissions rp 
    WHERE rp.role_name = user_role;
    
    RETURN COALESCE(permissions, '{}'::jsonb);
END;
$$;


