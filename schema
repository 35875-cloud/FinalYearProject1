CREATE FUNCTION public.check_blockchain_integrity() RETURNS TABLE(is_valid boolean, invalid_blocks text[], total_blocks integer)
    LANGUAGE plpgsql
    AS $$
DECLARE
    prev_hash TEXT;
    curr_block RECORD;
    invalid_list TEXT[] := ARRAY[]::TEXT[];
BEGIN
    total_blocks := (SELECT COUNT(*) FROM blockchain_ledger);
    
    FOR curr_block IN 
        SELECT * FROM blockchain_ledger ORDER BY block_index ASC
    LOOP
        -- Check if block index > 0 and previous hash matches
        IF curr_block.block_index > 0 THEN
            IF curr_block.previous_hash != prev_hash THEN
                invalid_list := array_append(invalid_list, 
                    'Block #' || curr_block.block_index || ' - Previous hash mismatch');
            END IF;
        END IF;
        
        -- Check if hash meets difficulty requirement
        IF LEFT(curr_block.blockchain_hash, 4) != '0000' THEN
            invalid_list := array_append(invalid_list, 
                'Block #' || curr_block.block_index || ' - Invalid PoW hash');
        END IF;
        
        prev_hash := curr_block.blockchain_hash;
    END LOOP;
    
    is_valid := (array_length(invalid_list, 1) IS NULL);
    invalid_blocks := invalid_list;
    
    RETURN QUERY SELECT is_valid, invalid_blocks, total_blocks;
END;
$$;


