CREATE VIEW public.lro_review_queue AS
 SELECT tr.transfer_id,
    tr.property_id,
    tr.seller_id,
    tr.buyer_id,
    tr.channel_id,
    tr.status AS transfer_status,
    tr.channel_status,
    tr.payment_status,
    tr.is_challenged,
    tr.lro_override_paid,
    tr.agreement_hash,
    tr.agreement_hash_at AS agreed_at,
    tr.agreed_price,
    tr.agreed_amount,
    tr.transfer_amount,
    tr.payment_hash,
    tr.final_hash,
    tr.buyer_payment_proof_url,
    tr.seller_payment_proof_url,
    tr.buyer_proof_uploaded_at,
    tr.seller_proof_uploaded_at,
    tr.challan_txn_id,
    tr.receipt_sent_at,
    tr.receipt_expires_at,
    tr.challenge_text AS challenge_description,
    tr.challenge_file_url AS evidence_file_url,
    tr.challenge_filed_at,
    tr.seller_upload_deadline AS seller_deadline,
    tr.created_at,
    tr.updated_at,
    tr.confirmed_at,
    p.district,
    p.tehsil,
    p.mauza,
    p.khasra_no,
    p.khatooni_no,
    p.area_marla,
    p.property_type,
    u_s.name AS seller_name,
    u_s.cnic AS seller_cnic,
    u_s.mobile AS seller_mobile,
    u_s.email AS seller_email,
    u_b.name AS buyer_name,
    u_b.cnic AS buyer_cnic,
    u_b.mobile AS buyer_mobile,
    u_b.email AS buyer_email,
        CASE
            WHEN (tr.lro_override_paid = true) THEN 'PAID_OVERRIDE'::text
            WHEN ((tr.status)::text = 'LRO_REVIEW'::text) THEN 'PAID'::text
            WHEN (tr.is_challenged = true) THEN 'CHALLENGED'::text
            WHEN (tr.payment_hash IS NOT NULL) THEN 'PAID'::text
            WHEN (tr.buyer_payment_proof_url IS NOT NULL) THEN 'PAID'::text
            WHEN ((tr.status)::text = 'AGREED'::text) THEN 'AGREED'::text
