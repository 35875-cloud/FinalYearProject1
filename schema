CREATE FUNCTION public.guard_blockchain_anchored_property_mutation() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
        DECLARE
          has_anchor BOOLEAN;
        BEGIN
          IF current_setting('app.allow_registry_canonical_mutation', true) = 'on' THEN
            RETURN NEW;
          END IF;

          SELECT EXISTS (
            SELECT 1
            FROM property_registry_integrity pri
            WHERE pri.property_id = NEW.property_id
              AND (
                pri.anchored_at IS NOT NULL
                OR pri.finalized_at IS NOT NULL
                OR pri.chain_tx_id IS NOT NULL
              )
          ) INTO has_anchor;

          IF NOT has_anchor THEN
            RETURN NEW;
          END IF;

          IF
            OLD.owner_id IS DISTINCT FROM NEW.owner_id OR
            OLD.owner_name IS DISTINCT FROM NEW.owner_name OR
            OLD.owner_cnic IS DISTINCT FROM NEW.owner_cnic OR
            OLD.father_name IS DISTINCT FROM NEW.father_name OR
            OLD.fard_no IS DISTINCT FROM NEW.fard_no OR
            OLD.khewat_no IS DISTINCT FROM NEW.khewat_no OR
            OLD.khasra_no IS DISTINCT FROM NEW.khasra_no OR
            OLD.khatooni_no IS DISTINCT FROM NEW.khatooni_no OR
            OLD.area_marla IS DISTINCT FROM NEW.area_marla OR
            OLD.district IS DISTINCT FROM NEW.district OR
            OLD.tehsil IS DISTINCT FROM NEW.tehsil OR
            OLD.mauza IS DISTINCT FROM NEW.mauza OR
            OLD.property_type IS DISTINCT FROM NEW.property_type
          THEN
            RAISE EXCEPTION
              'Blockchain-anchored property % cannot change canonical registry fields outside an approved blockchain workflow',
              NEW.property_id
              USING ERRCODE = 'P0001';
          END IF;

          RETURN NEW;
        END;
        $$;


